# Copy to frontend/.env for deployment builds.
# Development already works without this file: Vite proxies /api to the local backend.

# Leave empty (or omit) to use the same-origin "/api" prefix behind a reverse proxy.
# Set an absolute URL when the frontend and backend are served from different origins:
# VITE_API_BASE_URL=https://api.example.gov.in/api
VITE_API_BASE_URL=
