# Copy to backend/.env and adjust. Never commit the real .env file.

# --- Application -----------------------------------------------------------
APP_NAME="JANASEVA Hospital Grievance Monitoring System"
APP_ENV=development
API_PREFIX=/api

# --- Database --------------------------------------------------------------
# Local demo default when unset: SQLite file backend/janaseva.db
# Production target (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://janaseva:CHANGE_ME@localhost:5432/janaseva
DATABASE_URL=

# --- Security --------------------------------------------------------------
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=dev-only-change-me-8f4c1f0a2b9d4c6e8a7b5d3c1e0f9a8b
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Frontend / CORS -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo data -------------------------------------------------------------
# Seed synthetic complaints/staff on first startup (safe to leave on for demos).
SEED_DEMO_DATA=true
DEMO_PASSWORD=Janaseva@123

# --- Voice / IVR telephony (optional) --------------------------------------
# Leave blank to run in clearly labelled simulation mode.
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
# Shared secret used to verify POST /api/voice/webhook signatures.
VOICE_WEBHOOK_SECRET=

# --- Speech (optional) -----------------------------------------------------
# Without these the browser microphone fallback and text entry are used.
SPEECH_TO_TEXT_PROVIDER=
SPEECH_TO_TEXT_API_KEY=
TEXT_TO_SPEECH_PROVIDER=
TEXT_TO_SPEECH_API_KEY=

# --- SMS (optional) --------------------------------------------------------
# Without these, SMS notifications are recorded as "simulated", never "sent".
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
